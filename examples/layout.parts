# Placing things against each other instead of by numbers.
#
#   top = box ...            name a line; later lines read it (top.left, top.w, top.top_left_front)
#   on=top                   stand a thing on it; at= then measures from the middle of its top
#   on=drawers.front         stand a thing against another side: front, back, left, right, bottom
#   row x { ... }            lay copies end to end; stack { ... } piles them up
#   from=A to=B              run a beam, a rod or a part between two points
#
# A part is called like a shape (book, cup), and a shape without at= stands at the origin.

set oak=#6a4a2a/wood dark_oak=#5a3a22/wood pale_oak=#7a5a32/wood

# ------------------------------------------------------------------ small things

def book
  box size=rand(.025,.06),rand(.15,.21),rand(.2,.27) turn=rand(-2,2),0,0 \
      mat=pick(#8a2a2a,#2a4a6a,#3a6a3a,#c8a040,#e8e0d0,#4a2a4a)/paint

def bookend
  box size=.025,.14,.18 turn=0,-14,0 mat=brass

def paper
  box size=.3,.21,.004 turn=0,0,rand(-14,14) mat=#f0ece0/paint

def pen
  box size=.15,.012,.012 turn=0,0,35 mat=#2a2a2a/plastic

def cup
  cylinder radius=.04 height=.09 sides=6 mat=pick(#e8e0d0,#c84a3a,#3a6a9a,#e8c040)/plastic
  torus at=.045,0,.045 radius=.025 thick=.008 axis=y sides=6 rings=3 mat=pick(#e8e0d0,#c84a3a,#3a6a9a)/plastic

# A desk lamp: a weighted base, an arm up to its elbow, and the shade pointing down from there.
def anglepoise
  base = cylinder radius=.08 height=.03 sides=8 mat=steel_dark
  elbow = sphere at=-.06,.04,.42 radius=.02 sides=6 rings=3 mat=steel_dark
  cylinder from=base.top to=elbow radius=.012 sides=5 mat=steel_dark
  cone from=.14,-.02,.3 to=elbow radius=.08 sides=8 mat=#c84a3a/paint
  sphere at=.13,-.02,.31 radius=.03 sides=6 rings=3 mat=lamp_warm

# ------------------------------------------------------------------ the writer's desk

prop writers_desk "Writer's Desk" layout hero=1
  # The desk: a top on four legs, and a bank of two drawers under its right-hand end.
  top = bevel_box size=1.4,.7,.04 bevel=.01 at=0,0,on(.72) mat=oak
  legs4 w=1.3 d=.6 h=.72 m=dark_oak
  drawers = box size=.44,.62,.3 at=top.right-.27,0,on(.42) mat=dark_oak
  stack on=drawers.front pack=centre gap=.02 {
    box size=.4,.012,.12 mat=pale_oak repeat 2
  }

  # On it: books along the back, a lamp, a pile of papers with a pen, a cup.
  books = row x on=top at=-.42,.22 align=back {
    book repeat 10
  }
  bookend on=top at=books.right+.03,.24
  anglepoise on=top at=.5,.18
  papers = stack on=top at=-.1,-.12 {
    paper repeat 7
  }
  pen on=papers at=.06,0
  cup on=top at=.22,-.18

# ------------------------------------------------------------------ the kitchen dresser

def plate
  cylinder radius=.11 height=.015 axis=y sides=10 turn=rand(-6,6),0,0 mat=pick(#e8e4dc,#3a5a8a,#c8b8a0)/plastic

def jar
  cylinder radius=.05 height=rand(.12,.2) sides=6 mat=pick(#c8a040,#8a3a2a,#3a6a3a,#e8e0d0,#6a4a2a)/glass

prop kitchen_dresser "Kitchen Dresser" layout hero=1
  set paint=#4a6a7a/paint wood=#8a6a42/wood

  # The cupboard below: a body, two door fronts, a worktop.
  base = box size=1.3,.5,.85 mat=paint
  stack on=base.front pack=centre gap=.04 {
    box size=1.2,.012,.32 mat=#5a7a8a/paint repeat 2
  }
  worktop = box on=base size=1.36,.54,.04 mat=wood

  # The rack above: a back, two shelves, a crown, and the sides stood on the worktop.
  back = box on=worktop at=0,.2 size=1.3,.04,1.1 mat=paint
  low = box on=worktop at=0,.08,.38 size=1.3,.2,.025 mat=wood
  high = box on=worktop at=0,.08,.76 size=1.3,.2,.025 mat=wood
  crown = box on=back at=0,-.06 size=1.4,.22,.06 mat=paint
  box at=back.left-.0125,high.y,on(worktop) size=.025,.24,1.1 mat=paint mirror x

  # What is on it: plates along the low shelf behind a rail, jars on the high one, a cup.
  row x on=low over=1.1 align=back {
    plate repeat 5
  }
  cylinder from=low.left,low.front+.02,low.top+.05 to=low.right,low.front+.02,low.top+.05 radius=.008 sides=4 mat=brass
  row x on=high gap=.04 {
    jar repeat 7
  }
  cup on=worktop at=.3,-.1
